name: CI

on:
    push:
        branches: [main]
    pull_request:
        branches: [main]

jobs:
    build-test:
        runs-on: self-hosted
        steps:
            - name: Checkout repository
              uses: actions/checkout@v4
              with:
                  fetch-depth: 1
                  token: ${{ secrets.GITHUB_TOKEN }}

            - name: Run hog job
              run: ./scripts/ci/dogwood_bench_300k.sync.sh --j="dogwood-bench-300k-${{ github.run_id }}"
