# build and install with `makepkg -si`

pkgname=hogtools
pkgver=1.0.0
pkgrel=1
pkgdesc="Groundhog cluster tools (hog_hold_lock, hog_wait_lock, hog_exec, hog_copy)"
arch=('x86_64')
url="https://github.com/groundhogchain/chuckd"
license=('xxx')
depends=('glibc')
makedepends=('go' 'git')
source=("git+ssh://git@github.com/groundhogchain/chuckd.git")
sha256sums=('SKIP')

_tools=(
  hog_lockd
  hog_sched
  hog_fwd
  hog_signal
  hog_wait
)

# Automatically derive pkgver from git commit info
pkgver() {
  cd "$srcdir/chuckd"

  # If you have a tag matching 1.0.0, this gives: 1.0.0.r<N>.g<hash>
  local desc
  if desc=$(git describe --long --tags --match 'v*' 2>/dev/null); then
    # v1.0.0-5-gabc1234  ->  1.0.0.r5.gabc1234
    printf '%s\n' "$desc" | sed -E 's/^v//; s/-([0-9]+)-g/\.r\1.g/; s/-/./g'
  else
    # Fallback if you have no tags: r<N>.g<hash>
    printf 'r%s.g%s\n' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$srcdir/chuckd"
  for t in "${_tools[@]}"; do
    go build -o "$t" "./tools/$t"
  done
}

package() {
  cd "$srcdir/chuckd"
  for t in "${_tools[@]}"; do
    install -Dm755 "$t" "$pkgdir/usr/local/bin/$t"
  done
}
